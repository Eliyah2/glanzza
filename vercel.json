{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600, stale-if-error=86400" },
        { "key": "Link", "value": "</assets/css/style.css>; rel=preload; as=style; fetchpriority=high, <https://script.google.com>; rel=preconnect; crossorigin, <https://script.googleusercontent.com>; rel=preconnect; crossorigin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/og.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/voorwaarden", "destination": "/voorwaarden.html", "permanent": true }
  ]
}
